{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Gaming Performance API - Dashboard Baseline",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP - Temps de réponse & Throughput",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"gaming-performance-api\"}[1m])) by (le, uri)) * 1000",
          "legendFormat": "p50 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"gaming-performance-api\"}[1m])) by (le, uri)) * 1000",
          "legendFormat": "p95 {{uri}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"gaming-performance-api\"}[1m])) by (le, uri)) * 1000",
          "legendFormat": "p99 {{uri}}",
          "refId": "C"
        }
      ],
      "title": "Temps de réponse HTTP (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"gaming-performance-api\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]",
          "refId": "A"
        }
      ],
      "title": "Throughput (req/s par endpoint)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "JVM - CPU, Mémoire, Threads, GC",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 11,
      "targets": [
        {
          "expr": "process_cpu_usage{application=\"gaming-performance-api\"}",
          "legendFormat": "CPU Process",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage{application=\"gaming-performance-api\"}",
          "legendFormat": "CPU System",
          "refId": "B"
        }
      ],
      "title": "CPU JVM",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 12,
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"gaming-performance-api\", area=\"heap\"}",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"gaming-performance-api\", area=\"heap\"}",
          "legendFormat": "Heap Max",
          "refId": "B"
        },
        {
          "expr": "jvm_memory_used_bytes{application=\"gaming-performance-api\", area=\"nonheap\"}",
          "legendFormat": "Non-Heap Used",
          "refId": "C"
        }
      ],
      "title": "Mémoire JVM (Heap / Non-Heap)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 13,
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"gaming-performance-api\"}",
          "legendFormat": "Live Threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"gaming-performance-api\"}",
          "legendFormat": "Daemon Threads",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_states_threads{application=\"gaming-performance-api\", state=\"blocked\"}",
          "legendFormat": "Blocked Threads",
          "refId": "C"
        }
      ],
      "title": "Threads JVM",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "id": 14,
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"gaming-performance-api\"}[1m])",
          "legendFormat": "GC Pause Rate {{action}}",
          "refId": "A"
        }
      ],
      "title": "GC Pause Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "Base de données - HikariCP Pool JDBC",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 21,
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"gaming-performance-api\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"gaming-performance-api\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"gaming-performance-api\"}",
          "legendFormat": "Pending (attente pool)",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_max{application=\"gaming-performance-api\"}",
          "legendFormat": "Max Pool Size",
          "refId": "D"
        }
      ],
      "title": "HikariCP - Connexions Pool JDBC",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 22,
      "targets": [
        {
          "expr": "hikaricp_connections_acquire_seconds_sum{application=\"gaming-performance-api\"} / hikaricp_connections_acquire_seconds_count * 1000",
          "legendFormat": "Avg Acquire Time",
          "refId": "A"
        }
      ],
      "title": "HikariCP - Temps d'acquisition connexion",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 30,
      "title": "Métriques Métier - Dashboard & Stats",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 31,
      "targets": [
        {
          "expr": "rate(dashboard_build_time_seconds_sum{application=\"gaming-performance-api\"}[1m]) / rate(dashboard_build_time_seconds_count[1m]) * 1000",
          "legendFormat": "Dashboard Build Time (avg ms)",
          "refId": "A"
        },
        {
          "expr": "rate(player_stats_computation_seconds_sum{application=\"gaming-performance-api\"}[1m]) / rate(player_stats_computation_seconds_count[1m]) * 1000",
          "legendFormat": "Player Stats Computation (avg ms)",
          "refId": "B"
        }
      ],
      "title": "Temps de calcul métier",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 32,
      "targets": [
        {
          "expr": "rate(match_created_total{application=\"gaming-performance-api\"}[1m])",
          "legendFormat": "Matches créés/min",
          "refId": "A"
        },
        {
          "expr": "rate(kafka_match_events_consumed_total{application=\"gaming-performance-api\"}[1m])",
          "legendFormat": "Events Kafka consommés/min",
          "refId": "B"
        }
      ],
      "title": "Activité Kafka & Création de matchs",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["gaming", "performance", "java"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "title": "Gaming API - Performance Dashboard",
  "uid": "gaming-perf-001",
  "version": 1
}
